MONGO_URL=""
DB_NAME="test_database"
CORS_ORIGINS="*"

# Use mock database (set to 'false' to use real MongoDB)
USE_MOCK_DB="true"

# JWT Secret Key (change in production)
JWT_SECRET_KEY="organconnect-secret-key-change-in-production"



# Email Service Configuration (SendGrid)
USE_REAL_EMAIL="false"  # Set to 'true' to enable real email sending
SENDGRID_API_KEY=""  # Add your SendGrid API key here
FROM_EMAIL="noreply@organconnect.com"
FRONTEND_URL="http://localhost:8080"

# SMS Service Configuration (Twilio - Future Use)
ENABLE_SMS="false"  # Set to 'true' when ready to enable SMS
TWILIO_ACCOUNT_SID=""  # Add when enabling SMS
TWILIO_AUTH_TOKEN=""  # Add when enabling SMS
TWILIO_PHONE_NUMBER=""  # Add when enabling SMS
